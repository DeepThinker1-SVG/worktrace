{
  "name": "worktrace",
  "productName": "Worktrace",
  "version": "0.2.0",
  "private": false,
  "description": "A lightweight, local-first desktop event board for tracking work in Markdown.",
  "author": "Worktrace",
  "license": "MIT",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "build": "electron-forge package",
    "make": "npm run build && electron-builder --win nsis --prepackaged out/Worktrace-win32-x64"
  },
  "dependencies": {
    "@electron-forge/plugin-vite": "^7.8.3",
    "@types/mdast": "^4.0.4",
    "chokidar": "^5.0.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-position": "^5.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.30.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.worktrace.app",
    "productName": "Worktrace",
    "directories": {
      "output": "out/nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "resources/icons/workboard.ico",
      "uninstallerIcon": "resources/icons/workboard.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Worktrace",
      "artifactName": "worktrace-${version} Setup.${ext}"
    }
  },
  "config": {}
}
